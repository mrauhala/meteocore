netcdf pressure_levels_pa {
dimensions:
	time = 2 ;
	level = 3 ;
	latitude = 4 ;
	longitude = 5 ;
variables:
	double time(time) ;
		time:standard_name = "time" ;
		time:units = "hours since 2026-01-01 00:00:00" ;
		time:calendar = "gregorian" ;
	float level(level) ;
		level:standard_name = "air_pressure" ;
		level:long_name = "pressure" ;
		level:units = "Pa" ;
		level:positive = "down" ;
	float latitude(latitude) ;
		latitude:standard_name = "latitude" ;
		latitude:units = "degrees_north" ;
	float longitude(longitude) ;
		longitude:standard_name = "longitude" ;
		longitude:units = "degrees_east" ;
	float t(time, level, latitude, longitude) ;
		t:standard_name = "air_temperature" ;
		t:long_name = "Temperature" ;
		t:units = "K" ;
		t:_FillValue = -9999.f ;
		t:_Storage = "chunked" ;
		t:_ChunkSizes = 1, 1, 4, 5 ;
		t:_DeflateLevel = 3 ;
		t:_Shuffle = "true" ;
	float u(time, level, latitude, longitude) ;
		u:standard_name = "eastward_wind" ;
		u:long_name = "U component of wind" ;
		u:units = "m s-1" ;
		u:_FillValue = -9999.f ;
		u:_Storage = "chunked" ;
		u:_ChunkSizes = 1, 1, 4, 5 ;
		u:_DeflateLevel = 3 ;
		u:_Shuffle = "true" ;
	float v(time, level, latitude, longitude) ;
		v:standard_name = "northward_wind" ;
		v:long_name = "V component of wind" ;
		v:units = "m s-1" ;
		v:_FillValue = -9999.f ;
		v:_Storage = "chunked" ;
		v:_ChunkSizes = 1, 1, 4, 5 ;
		v:_DeflateLevel = 3 ;
		v:_Shuffle = "true" ;

