netcdf laea {
dimensions:
	time = 1 ;
	y = 9 ;
	x = 9 ;
variables:
	double time(time) ;
		time:standard_name = "time" ;
		time:units = "hours since 2026-01-01 00:00:00" ;
		time:calendar = "standard" ;
	double y(y) ;
		y:standard_name = "projection_y_coordinate" ;
		y:units = "m" ;
	double x(x) ;
		x:standard_name = "projection_x_coordinate" ;
		x:units = "m" ;
	int crs ;
		crs:grid_mapping_name = "lambert_azimuthal_equal_area" ;
		crs:latitude_of_projection_origin = 52. ;
		crs:longitude_of_projection_origin = 10. ;
		crs:false_easting = 4321000. ;
		crs:false_northing = 3210000. ;
		crs:semi_major_axis = 6378137. ;
		crs:inverse_flattening = 298.257222101 ;
	double easting(time, y, x) ;
		easting:long_name = "Projected x of the cell centre" ;
		easting:units = "m" ;
		easting:grid_mapping = "crs" ;
	double northing(time, y, x) ;
		northing:long_name = "Projected y of the cell centre" ;
		northing:units = "m" ;
		northing:grid_mapping = "crs" ;

// global attributes:
		:Conventions = "CF-1.8" ;
		:title = "Synthetic laea grid, MeteoCore test fixture" ;
data:

 time = 0 ;

 y = 2250000, 2500000, 2750000, 3000000, 3250000, 3500000, 3750000, 4000000, 4250000 ;

 x = 3500000, 3750000, 4000000, 4250000, 4500000, 4750000, 5000000, 5250000, 5500000 ;

 crs = 0 ;

 easting =
    3500000, 3750000, 4000000, 4250000, 4500000, 4750000, 5000000, 5250000, 5500000,
    3500000, 3750000, 4000000, 4250000, 4500000, 4750000, 5000000, 5250000, 5500000,
    3500000, 3750000, 4000000, 4250000, 4500000, 4750000, 5000000, 5250000, 5500000,
    3500000, 3750000, 4000000, 4250000, 4500000, 4750000, 5000000, 5250000, 5500000,
    3500000, 3750000, 4000000, 4250000, 4500000, 4750000, 5000000, 5250000, 5500000,
    3500000, 3750000, 4000000, 4250000, 4500000, 4750000, 5000000, 5250000, 5500000,
    3500000, 3750000, 4000000, 4250000, 4500000, 4750000, 5000000, 5250000, 5500000,
    3500000, 3750000, 4000000, 4250000, 4500000, 4750000, 5000000, 5250000, 5500000,
    3500000, 3750000, 4000000, 4250000, 4500000, 4750000, 5000000, 5250000, 5500000 ;

 northing =
    2250000, 2250000, 2250000, 2250000, 2250000, 2250000, 2250000, 2250000, 2250000,
    2500000, 2500000, 2500000, 2500000, 2500000, 2500000, 2500000, 2500000, 2500000,
    2750000, 2750000, 2750000, 2750000, 2750000, 2750000, 2750000, 2750000, 2750000,
    3000000, 3000000, 3000000, 3000000, 3000000, 3000000, 3000000, 3000000, 3000000,
    3250000, 3250000, 3250000, 3250000, 3250000, 3250000, 3250000, 3250000, 3250000,
    3500000, 3500000, 3500000, 3500000, 3500000, 3500000, 3500000, 3500000, 3500000,
    3750000, 3750000, 3750000, 3750000, 3750000, 3750000, 3750000, 3750000, 3750000,
    4000000, 4000000, 4000000, 4000000, 4000000, 4000000, 4000000, 4000000, 4000000,
    4250000, 4250000, 4250000, 4250000, 4250000, 4250000, 4250000, 4250000, 4250000 ;
}
