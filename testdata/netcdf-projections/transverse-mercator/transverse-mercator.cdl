netcdf transverse_mercator {
dimensions:
	time = 1 ;
	y = 13 ;
	x = 11 ;
variables:
	double time(time) ;
		time:standard_name = "time" ;
		time:units = "hours since 2026-01-01 00:00:00" ;
		time:calendar = "standard" ;
	double y(y) ;
		y:standard_name = "projection_y_coordinate" ;
		y:units = "m" ;
	double x(x) ;
		x:standard_name = "projection_x_coordinate" ;
		x:units = "m" ;
	int crs ;
		crs:grid_mapping_name = "transverse_mercator" ;
		crs:scale_factor_at_central_meridian = 0.9996 ;
		crs:longitude_of_central_meridian = 15. ;
		crs:latitude_of_projection_origin = 0. ;
		crs:false_easting = 500000. ;
		crs:false_northing = 0. ;
		crs:semi_major_axis = 6378137. ;
		crs:inverse_flattening = 298.257223563 ;
	double easting(time, y, x) ;
		easting:long_name = "Projected x of the cell centre" ;
		easting:units = "m" ;
		easting:grid_mapping = "crs" ;
	double northing(time, y, x) ;
		northing:long_name = "Projected y of the cell centre" ;
		northing:units = "m" ;
		northing:grid_mapping = "crs" ;

