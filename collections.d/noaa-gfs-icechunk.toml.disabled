# Example: NOAA GFS forecast as an Icechunk repository on public S3
# (dynamical.org, https://registry.opendata.aws/dynamical-noaa-gfs/).
#
# DISABLED by default (needs the icechunk feature + network). To run:
#   1. rename to drop `.disabled`
#   2. cargo run -p server --features icechunk -- --collections=noaa-gfs-icechunk
#
# Distinct id from the GRIB `noaa-gfs.toml` example. Forecast: the engine serves
# the LATEST run with valid time (= run + lead) as the time axis (#337 for run
# selection). Values are served in display units from each array's CF `units`
# (#1213): a K, Pa or kg m-2 s-1 array as °C, hPa or mm/h; temperature_2m is
# stored in degrees Celsius already. Each layer takes the built-in default its
# name and unit select (temperature over -90…50 °C).
# Verified live via the probe_models test.

id = "noaa-gfs-icechunk"
title = "NOAA GFS forecast (Icechunk)"
description = "NOAA GFS deterministic forecast, global 0.25° regular lat/lon, from an Icechunk repository on public S3 (dynamical.org, CC-BY-4.0)."
engine_type = "zarr"
apis = ["edr", "wms", "maps", "tiles"]
keywords = ["forecast", "GFS", "NOAA", "icechunk"]

[license]
title = "CC-BY-4.0"

[zarr]
endpoint = "https://s3.us-west-2.amazonaws.com"
bucket = "dynamical-noaa-gfs"
path = "noaa-gfs-forecast/v0.2.7.icechunk"
# Focused demo; the repo has ~21 params (temperature, winds, precipitation, …).
parameters = ["temperature_2m"]

[zarr.icechunk]
branch = "main"
region = "us-west-2"

# The collection's own layer draws temperature_2m: the temperature palette
# over its own -90…50 °C, as the layer's default.
[wms]
colormap = "temperature"
# A WebP request without a quality of its own is lossy at 80: continuous
# palettes exceed PNG8's 256 colours (README, "Choosing an image format").
webp_quality = 80
