# Example: ECMWF AIFS-single forecast as an Icechunk repository on public S3
# (dynamical.org, https://registry.opendata.aws/dynamical-ecmwf-aifs-single/).
#
# DISABLED by default (`.toml.disabled` is ignored by the loader) because it:
#   1. requires the server built with the icechunk feature, and
#   2. fetches from the network (anonymous AWS S3, us-west-2).
#
# To run it from collections.d:
#   1. rename this file to drop `.disabled`
#   2. cargo run -p server --features icechunk -- --collections=ecmwf-aifs-single-icechunk
#      (the `--collections` filter avoids loading the other, remote, collections)
#
# Verified live: serves EDR + WMS/Maps/Tiles. Values are served in display
# units from each array's CF `units` (#1213): a K, Pa or kg m-2 s-1 array as
# °C, hPa or mm/h; temperature_2m is stored in degrees Celsius already. Each
# layer takes the built-in default its name and unit select (temperature over
# -90…50 °C).
#
# Forecast: the engine uses the LATEST run and exposes valid time (= run + lead)
# as the time axis. Selecting older runs (EDR instances / WMS reference_time) is
# tracked in #337.

id = "ecmwf-aifs-single-icechunk"
title = "ECMWF AIFS-single forecast (Icechunk)"
description = "ECMWF AIFS deterministic AI forecast, global 0.25° regular lat/lon, as an Icechunk repository on public S3 (dynamical.org, CC-BY-4.0)."
engine_type = "zarr"
apis = ["edr", "wms", "maps", "tiles"]
keywords = ["forecast", "AIFS", "ECMWF", "icechunk"]

[license]
title = "CC-BY-4.0"

[zarr]
endpoint = "https://s3.us-west-2.amazonaws.com"
bucket = "dynamical-ecmwf-aifs-single"
path = "ecmwf-aifs-single-forecast/v0.1.0.icechunk"
# Focused demo; the repo also has wind_u_10m/wind_v_10m,
# pressure_reduced_to_mean_sea_level, precipitation_surface, and ~13 more.
parameters = ["temperature_2m"]

# Presence of this table selects the Icechunk backend. Default version = branch
# `main` HEAD (new forecast cycles surface on the poll interval).
[zarr.icechunk]
branch = "main"
region = "us-west-2"

# The collection's own layer draws temperature_2m: the temperature palette
# over its own -90…50 °C, as the layer's default.
[wms]
colormap = "temperature"
# A WebP request without a quality of its own is lossy at 80: continuous
# palettes exceed PNG8's 256 colours (README, "Choosing an image format").
webp_quality = 80
