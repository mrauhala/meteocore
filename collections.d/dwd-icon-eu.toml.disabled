# Example: DWD ICON-EU forecast as an Icechunk repository on public S3
# (dynamical.org, https://registry.opendata.aws/dynamical-dwd-icon-eu/).
#
# DISABLED by default (needs the icechunk feature + network). To run:
#   1. rename to drop `.disabled`
#   2. cargo run -p server --features icechunk --collections=dwd-icon-eu
#
# Regional (Europe), regular lat/lon — a good non-global-extent test. Forecast:
# the engine serves the LATEST run with valid time (= run + lead) as the time
# axis (#337 for run selection). temperature_2m is in degrees Celsius (no unit
# conversion). Verified live via the probe_models test.

id = "dwd-icon-eu"
title = "DWD ICON-EU forecast (Icechunk)"
description = "DWD ICON-EU regional forecast over Europe, regular lat/lon, from an Icechunk repository on public S3 (dynamical.org, CC-BY-4.0)."
engine_type = "zarr"
apis = ["edr", "wms", "maps", "tiles"]
keywords = ["forecast", "ICON-EU", "DWD", "icechunk", "Europe"]

[license]
title = "CC-BY-4.0"

[zarr]
endpoint = "https://s3.us-west-2.amazonaws.com"
bucket = "dynamical-dwd-icon-eu"
path = "dwd-icon-eu-forecast-5-day/v0.2.0.icechunk"
# Focused demo; the repo has ~19 params (temperature, cloud cover, wind, …).
parameters = ["temperature_2m"]

[zarr.icechunk]
branch = "main"
region = "us-west-2"

[wms]
colormap = "temperature"

[[wms.parameters]]
name = "temperature_2m"
colormap = "temperature"
min = -30.0
max = 40.0
